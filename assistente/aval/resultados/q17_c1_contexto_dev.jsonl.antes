{"id": "documentos-014", "categoria": "documentos", "subtipo": "valor_condicao", "config": "c1_contexto", "assinatura": "f9a019b0e2d1956c78f5a3774d5a1e67c8f78ac1594b708542add6e904a4664d", "resposta": "COXA DE FRANGO (600 g): 180 °C por 25 minutos, virar na metade do tempo.", "raciocinio_chars": 0, "fim": "stop", "cortada": false, "t_primeiro": 5.876869313011412, "t_primeiro_texto": 5.876869574014563, "t_total": 21.98540780998883, "tokens_prompt": 792, "tokens_resposta": 32, "tokens_prompt_total": 792, "tokens_resposta_total": 32, "tempos": {"cache_n": 173, "prompt_n": 619, "prompt_ms": 5774.812, "prompt_per_token_ms": 9.329260096930533, "prompt_per_second": 107.18963664964332, "predicted_n": 32, "predicted_ms": 16108.256, "predicted_per_token_ms": 519.6211612903226, "predicted_per_second": 1.9244789752534355}, "rastro": [{"passo": "modelo", "tokens_prompt": 792, "tokens_resposta": 32, "t": 21.99, "chamadas": []}], "ok": true, "vazia": false, "repeticao": false, "verificacoes": [{"tipo": "contem", "ok": true, "detalhe": "180"}, {"tipo": "numero", "ok": true, "detalhe": "25"}, {"tipo": "idioma", "ok": true, "detalhe": "pt"}], "idioma": "pt", "palavras": 15}
{"id": "documentos-015", "categoria": "documentos", "subtipo": "passos", "config": "c1_contexto", "assinatura": "f9a019b0e2d1956c78f5a3774d5a1e67c8f78ac1594b708542add6e904a4664d", "resposta": "O código E2 indica superaquecimento. Deve-se desligar a fritadeira, aguardar 30 minutos e depois reiniciar.", "raciocinio_chars": 0, "fim": "stop", "cortada": false, "t_primeiro": 5.978996628022287, "t_primeiro_texto": 5.978996953024762, "t_total": 23.28394502500305, "tokens_prompt": 795, "tokens_resposta": 35, "tokens_prompt_total": 795, "tokens_resposta_total": 35, "tempos": {"cache_n": 173, "prompt_n": 622, "prompt_ms": 5835.388, "prompt_per_token_ms": 9.38165273311897, "prompt_per_second": 106.59102702339588, "predicted_n": 35, "predicted_ms": 17304.718, "predicted_per_token_ms": 508.9622941176471, "predicted_per_second": 1.9647820900635307}, "rastro": [{"passo": "modelo", "tokens_prompt": 795, "tokens_resposta": 35, "t": 23.28, "chamadas": []}], "ok": false, "vazia": false, "repeticao": false, "verificacoes": [{"tipo": "contem_algum", "ok": true, "detalhe": "30 minutos|30 min"}, {"tipo": "contem_algum", "ok": false, "detalhe": "desligu|tire da tomada|tirar da tomada"}, {"tipo": "idioma", "ok": true, "detalhe": "indefinido"}], "idioma": "indefinido", "palavras": 15}
{"id": "documentos-008", "categoria": "documentos", "subtipo": "calculo", "config": "c1_contexto", "assinatura": "f9a019b0e2d1956c78f5a3774d5a1e67c8f78ac1594b708542add6e904a4664d", "resposta": "A multa é calculada conforme o número de meses faltantes. Se houver 4 meses faltando, a multa será de R$ 240,00 x 4 / 12 = R$ 80,00.", "raciocinio_chars": 0, "fim": "stop", "cortada": false, "t_primeiro": 5.8561024270020425, "t_primeiro_texto": 5.85610284600989, "t_total": 49.24042792399996, "tokens_prompt": 792, "tokens_resposta": 57, "tokens_prompt_total": 792, "tokens_resposta_total": 57, "tempos": {"cache_n": 173, "prompt_n": 619, "prompt_ms": 5762.438, "prompt_per_token_ms": 9.309269789983846, "prompt_per_second": 107.41981085089331, "predicted_n": 57, "predicted_ms": 43384.099, "predicted_per_token_ms": 774.7160535714286, "predicted_per_second": 1.2907955055145894}, "rastro": [{"passo": "modelo", "tokens_prompt": 792, "tokens_resposta": 57, "t": 49.24, "chamadas": []}], "ok": true, "vazia": false, "repeticao": false, "verificacoes": [{"tipo": "numero", "ok": true, "detalhe": "80"}, {"tipo": "idioma", "ok": true, "detalhe": "pt"}], "idioma": "pt", "palavras": 28}
